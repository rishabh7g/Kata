{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kata:fixtures/module-index.fixture.schema.json",
  "title": "Harness fixture — NOT the shipping content schema",
  "description": "A cut-down stand-in for schemas/module-index.schema.json (#7), here only so scripts/validate-content.mjs can be exercised against known-good and known-bad JSON. Nothing reads it at runtime; the real schema is the one in docs/engineering.md § 3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ordinal", "title", "pending"],
        "properties": {
          "id": { "type": "string", "pattern": "^m\\d{2}$" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "pending": { "type": "boolean" }
        }
      }
    }
  }
}
